<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".wealth.AddDebtActivity">

    <!-- Top Action Bar -->
    <include layout="@layout/custom_toolbar_without_left_icon_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Subheader: Back link -->
            <TextView
                android:id="@+id/btnBackToCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ Back to Category"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingVertical="4dp" />

            <!-- SECTION 1: BASIC INFORMATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textColor="#111827"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Loan Category -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loan Category *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etLoanCategory"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bottom_nav_bar_bg"
                        android:focusable="false"
                        android:clickable="false"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Loan Status -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loan Status *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spLoanStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Loan Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan Name *"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <EditText
                android:id="@+id/etLoanName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:hint="E.g. HDFC Home Loan, SBI Car Loan"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#111827"
                android:textSize="14sp" />

            <!-- Lender Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lender Name *"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <EditText
                android:id="@+id/etLenderName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:hint="E.g. HDFC Bank, SBI"
                android:inputType="textCapWords"
                android:paddingHorizontal="12dp"
                android:textColor="#111827"
                android:textSize="14sp" />

            <!-- SECTION 2: LOAN & REPAYMENT DETAILS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loan &amp; Repayment Details"
                android:textColor="#111827"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginTop="20dp" />

            <!-- Principal & Outstanding Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Principal *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="Amount in INR"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outstanding *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etOutstanding"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="Outstanding Principal"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Interest Rate & Tenure Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Interest Rate (%) *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etInterestRate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="E.g. 8.5"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tenure (Months) *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTenureMonths"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="E.g. 240"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- EMI Amount Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMI Amount *"
                android:textColor="#374151"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etEmiAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:hint="E.g. 15000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="#111827"
                android:textSize="13sp" />

            <!-- Start Date & End Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Date *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="dd/mm/yyyy"
                        android:focusable="false"
                        android:clickable="true"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End Date *"
                        android:textColor="#374151"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEndDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:drawable/edit_text"
                        android:hint="dd/mm/yyyy"
                        android:focusable="false"
                        android:clickable="true"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111827"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Floating Interest Rate & Prepayment Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Spinner
                    android:id="@+id/spInterestType"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@android:drawable/btn_dropdown" />

                <Spinner
                    android:id="@+id/spPrepayment"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>

            <!-- Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes / Remarks"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp" />

            <EditText
                android:id="@+id/etDebtNotes"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="4dp"
                android:background="@android:drawable/edit_text"
                android:gravity="top|start"
                android:hint="Optional loan notes..."
                android:inputType="textMultiLine"
                android:padding="10dp"
                android:textColor="#111827"
                android:textSize="13sp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelDebt"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#6B7280"
                    app:strokeColor="#D1D5DB"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveDebt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Save Debt"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

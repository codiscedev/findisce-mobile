<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Recurring Bill"
            android:textColor="#111827"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up subscription or scheduled recurring payment details"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- Bill Name Input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bill / Subscription Name *"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etBillName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="E.g. Netflix Subscription"
            android:inputType="textCapWords"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Amount & Debit Day Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount (₹) *"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBillAmount"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="E.g. 199"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debit Day (1-31)"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etDebitDay"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="E.g. 5"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Frequency Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frequency *"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <Spinner
            android:id="@+id/spBillFrequency"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <!-- Category & Subcategory Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category *"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spBillCategory"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub-Category"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSubcategory"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:hint="E.g. Streaming"
                    android:inputType="textCapWords"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Payment Method Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method *"
            android:textColor="#374151"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <Spinner
            android:id="@+id/spPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelModalBill"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#374151"
                android:textSize="13sp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveModalBill"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Save Bill"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

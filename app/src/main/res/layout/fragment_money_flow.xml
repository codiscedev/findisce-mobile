<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track, categorize and analyze all your cash outflows."
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp" />

        <!-- Horizontal Scrollable Sub-Tab Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:id="@+id/tabs"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Spending -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabSpending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spending"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:iconTint="#FFFFFF"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <!-- 2. Recurring Bills -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabBills"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recurring Bills"
                    android:textAllCaps="false"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <!-- 3. Budget -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabBudget"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget"
                    android:textAllCaps="false"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <!-- 4. Income -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabIncome"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Income"
                    android:textAllCaps="false"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <!-- 5. Credit Cards -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabCreditCards"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credit Cards"
                    android:textAllCaps="false"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="8dp" />

                <!-- 6. Cash Flow -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabCashFlow"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cash Flow"
                    android:textAllCaps="false"
                    android:textColor="#4B5563"
                    android:textSize="16sp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/container"
            android:background="@color/bg"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</ScrollView>

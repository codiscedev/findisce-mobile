<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Money Flow Ledger"
            android:textColor="#0047AB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Track all incomes and categorize expenses."
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Add transaction block -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD TRANSACTION"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etTxName"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="Transaction description"
                    android:inputType="text"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTxAmount"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="Amount in ₹"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp" />

                <!-- Radio selections -->
                <RadioGroup
                    android:id="@+id/rgTxType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:checkedButton="@+id/rbExpense">

                    <RadioButton
                        android:id="@+id/rbExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expense"
                        android:textSize="13sp"
                        android:layout_marginEnd="16dp" />

                    <RadioButton
                        android:id="@+id/rbIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Income"
                        android:textSize="13sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnAddTx"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Add Transaction"
                    android:backgroundTint="#0047AB"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSACTION LOGS"
            android:textColor="#888888"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <!-- Transactions log container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:id="@+id/llTxItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/listDivider"
                android:showDividers="middle">

                <!-- Populated dynamically via Kotlin code -->
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

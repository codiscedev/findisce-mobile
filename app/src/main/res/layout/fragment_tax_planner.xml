<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tax Regime Planner"
            android:textColor="#0047AB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optimize deductions between Old and New tax regimes."
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Preferred Regime Cards -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOMMENDED CHOICE"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Tax Regime"
                    android:textColor="#10b981"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated savings: ₹12,400 in the current assessment year."
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Input Deductions -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAX DECLARATION DEDUCTIONS"
                    android:textColor="#888888"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Section 80C (PPF, ELSS, Insurance)"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etDeduction80C"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="150000"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Section 80D (Health Insurance Premium)"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etDeduction80D"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="25000"
                    android:inputType="number"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnRecalculateTax"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Recalculate Savings"
                    android:backgroundTint="#0047AB"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

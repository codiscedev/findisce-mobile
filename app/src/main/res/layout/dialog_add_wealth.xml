<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etDialogWealthName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Item Name (e.g., Stocks, Real Estate, Loan)"
        android:inputType="text"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDialogWealthAmount"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Amount in ₹"
        android:inputType="number"
        android:background="@android:drawable/edit_text"
        android:padding="10dp"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <RadioGroup
        android:id="@+id/rgDialogWealthType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:checkedButton="@+id/rbDialogAsset">

        <RadioButton
            android:id="@+id/rbDialogAsset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asset"
            android:textSize="14sp"
            android:layout_marginEnd="24dp" />

        <RadioButton
            android:id="@+id/rbDialogDebt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liability / Debt"
            android:textSize="14sp" />
    </RadioGroup>

</LinearLayout>
